# ---- Server ----
PORT=5050
# Base address used in emailed links (the address people open in their browser)
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- MySQL 8.0 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=insurepress
DB_PASSWORD=insurepress
DB_NAME=insurepress_studio

# ---- AI (Anthropic Claude) ----
# Leave ANTHROPIC_API_KEY empty to run the AI Co-Pilot in mock mode (deterministic sample output).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# ---- Export engine ----
# Optional: use a system Chrome/Chromium instead of Puppeteer's bundled download.
PUPPETEER_EXECUTABLE_PATH=
EXPORT_DIR=../exports

# ---- Authentication ----
# Signs login sessions. Use a long random value in production: openssl rand -hex 32
# If empty, a random secret is generated at start-up and everyone is signed out on each restart.
JWT_SECRET=
# Let anyone create an author account from the login page (true/false). Admins can always add users.
ALLOW_REGISTRATION=false

# ---- Email (password reset links & security notices) ----
# Any SMTP provider works: Google Workspace/Gmail (app password), Zoho Mail, Brevo, Mailgun, SendGrid, Amazon SES.
# Leave SMTP_HOST empty to turn email off ("Forgot password" is hidden; admins reset passwords instead).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=InsurePress Studio <no-reply@yourbrokerage.ng>
# Minutes a reset link stays valid
RESET_LINK_MINUTES=60
# Development only: print emails to the server console instead of sending them
# MAIL_TRANSPORT=log
