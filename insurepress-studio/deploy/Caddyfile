# Reverse proxy in front of InsurePress Studio.
# - DOMAIN set to a real hostname (e.g. studio.example.ng) -> automatic HTTPS via Let's Encrypt.
# - DOMAIN=:80 -> plain HTTP (testing only: browsers won't keep the sign-in cookie secure).
# Sign-in is handled by the app itself (email + password accounts).
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:5050 {
		# PDF exports can take ~40 s
		transport http {
			read_timeout 180s
		}
	}
}
