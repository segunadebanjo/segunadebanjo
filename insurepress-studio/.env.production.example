# Copy to .env on the server, next to docker-compose.yml, and fill in.

# Public hostname. Point its DNS A record at the server first; Caddy then gets an HTTPS certificate.
DOMAIN=studio.example.ng
PUBLIC_URL=https://studio.example.ng

# Signs login sessions. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=replace-with-64-random-hex-characters

# Let anyone sign up from the login page (true/false). Admins can always add users from "Manage users".
ALLOW_REGISTRATION=false

# Database (only reachable inside the Docker network).
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=insurepress_studio
DB_USER=insurepress
DB_PASSWORD=change-me-app

# AI. Leave the key empty to run the Co-Pilot in mock mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
