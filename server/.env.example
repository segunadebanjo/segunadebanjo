# ---- App server ----
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# ---- Reporting database (this add-on's own MySQL schema) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=naicom
DB_PASSWORD=naicom
DB_NAME=naicom_returns

# ---- Existing brokerage ERP database (read-only user recommended) ----
# Leave ERP_DB_HOST empty to disable direct DB pull (use push API / CSV instead).
ERP_DB_HOST=
ERP_DB_PORT=3306
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_NAME=
# Cron expression for automatic ERP pull (empty = manual only). Example: every night 01:30
ERP_SYNC_CRON=30 1 * * *

# ---- ERP push API ----
# The ERP sends this in the "x-api-key" header to POST /api/ingest/:entity
INGEST_API_KEY=change-me-ingest-key

# ---- ERP single sign-on (launch the add-on from inside the ERP) ----
# The ERP signs a short-lived HS256 JWT {email, name, role} with this secret and opens
#   https://<addon-host>/sso?token=<jwt>
ERP_SSO_SECRET=change-me-sso-secret

# Initial admin created by `npm run migrate`
ADMIN_EMAIL=admin@broker.local
ADMIN_PASSWORD=Admin@123
