# ---- Server ----
PORT=4100
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Database (MySQL 8.0) ----
# docker compose (see ../docker-compose.yml) exposes MySQL on host port 3307
DATABASE_URL="mysql://adsuser:adspass@localhost:3307/insurance_ads"

# ---- Sandbox: simulate all ad-platform + CAPI calls and generate synthetic metrics ----
SANDBOX_MODE=true

# ---- Conversion webhook (ERP / quote portal) ----
WEBHOOK_SECRET_KEY=change-me-long-random-string

# ---- Anthropic (AI creative generation + AI compliance pre-flight) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Meta (Facebook & Instagram Marketing API + Conversions API) ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_PIXEL_ID=
META_API_VERSION=v21.0

# ---- Google Ads API ----
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_API_VERSION=v18

# ---- LinkedIn Marketing API + Conversions API ----
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_CONVERSION_RULE_ID=
LINKEDIN_API_VERSION=202410
LINKEDIN_ACCOUNT_CURRENCY=USD
# Used to convert NGN budgets/spend for LinkedIn (no NGN ad accounts)
FX_NGN_PER_USD=1550

# ---- Scheduled jobs (node-cron) ----
METRICS_SYNC_CRON="0 * * * *"
OPTIMIZATION_CRON="15 * * * *"
DISABLE_CRON=false

# Optional: path to the built React app served at "/" (defaults to ../client/dist)
# CLIENT_DIST=

# ---- Sign-in (email/password) ----
# Long random string used to sign session cookies. REQUIRED when NODE_ENV=production (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# How long a sign-in lasts (hours)
AUTH_SESSION_HOURS=12
# Secure (HTTPS-only) cookies; defaults to true when NODE_ENV=production
# AUTH_COOKIE_SECURE=
# Seeder: demo accounts get this temporary password (must be changed at first sign-in)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_USER_PASSWORD=ChangeMe-2026
